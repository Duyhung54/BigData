# Mặc định của docker-compose.yml: chạy KÈM cụm HDFS (namenode + 2 datanode).
# Docker Compose tự đọc file này khi chạy docker-compose.yml trong thư mục docker/.
#
# Chạy KHÔNG có HDFS (mọi thứ trên ổ local), ghi đè ngay trên dòng lệnh:
#   COMPOSE_PROFILES= USE_HDFS=false docker compose -f docker/docker-compose.yml up -d
COMPOSE_PROFILES=hdfs
USE_HDFS=true
